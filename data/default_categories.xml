<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Kategori 1: Plastik -->
        <record id="cat_plastik" model="sirita.sampah.category">
            <field name="name">Plastik &amp; Botol Kemasan</field>
            <field name="code">CAT-PLASTIK</field>
            <field name="sequence">10</field>
            <field name="point_per_kg">2000.0</field>
            <field name="price_per_kg">2000.0</field>
            <field name="description">Botol plastik PET, gelas air mineral, jerigen, dan kantong plastik bersih.</field>
            <field name="is_active">True</field>
        </record>

        <!-- Kategori 2: Kertas & Kardus -->
        <record id="cat_kertas" model="sirita.sampah.category">
            <field name="name">Kertas &amp; Kardus</field>
            <field name="code">CAT-KERTAS</field>
            <field name="sequence">20</field>
            <field name="point_per_kg">1500.0</field>
            <field name="price_per_kg">1500.0</field>
            <field name="description">Kardus cokelat, kertas HVS sisa skripsi/tugas, koran, majalah, dan karton tebal.</field>
            <field name="is_active">True</field>
        </record>

        <!-- Kategori 3: Besi & Logam -->
        <record id="cat_besi" model="sirita.sampah.category">
            <field name="name">Besi &amp; Logam</field>
            <field name="code">CAT-LOGAM</field>
            <field name="sequence">30</field>
            <field name="point_per_kg">3500.0</field>
            <field name="price_per_kg">3500.0</field>
            <field name="description">Kaleng minuman aluminium, besi tua, seng, kawat, dan peralatan logam bekas.</field>
            <field name="is_active">True</field>
        </record>

        <!-- Kategori 4: Elektronik Bekas -->
        <record id="cat_elektronik" model="sirita.sampah.category">
            <field name="name">Elektronik Bekas (E-Waste)</field>
            <field name="code">CAT-ELEKTRONIK</field>
            <field name="sequence">40</field>
            <field name="point_per_kg">5000.0</field>
            <field name="price_per_kg">5000.0</field>
            <field name="description">Komponen komputer, charger rusak, kabel, smartphone bekas, dan PCB elektronik.</field>
            <field name="is_active">True</field>
        </record>

        <!-- Drop Point 1 -->
        <record id="dp_pusat" model="sirita.sampah.drop.point">
            <field name="name">Drop Point Pusat Parepare</field>
            <field name="code">DP-001</field>
            <field name="address">Jl. Bau Massepe No. 10, Parepare</field>
            <field name="latitude">-4.015</field>
            <field name="longitude">119.629</field>
            <field name="capacity_status">aman</field>
            <field name="operating_hours">08:00 - 17:00</field>
            <field name="is_active">True</field>
        </record>

        <!-- Drop Point 2 -->
        <record id="dp_soreang" model="sirita.sampah.drop.point">
            <field name="name">Drop Point Soreang</field>
            <field name="code">DP-002</field>
            <field name="address">Jl. Jendral Sudirman No. 5, Soreang</field>
            <field name="latitude">-3.992</field>
            <field name="longitude">119.635</field>
            <field name="capacity_status">aman</field>
            <field name="operating_hours">09:00 - 15:00</field>
            <field name="is_active">True</field>
        </record>
