<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_sampah_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.sampah.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="before">
                <header>
                    <button name="action_reset_sampah_password" string="Reset Password Akun" type="object" class="btn-warning" invisible="not is_nasabah_sampah and not is_petugas_sampah"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Bank Sampah" name="page_bank_sampah">
                    <group>
                        <group string="Profil &amp; Keanggotaan">
                            <field name="is_nasabah_sampah"/>
                            <field name="is_petugas_sampah"/>
                            <field name="nasabah_code"/>
                            <field name="default_setor_method"/>
                        </group>
                        <group string="Saldo &amp; Riwayat">
                            <field name="point_balance"/>
                            <field name="rupiah_balance"/>
                            <field name="transaction_count"/>
                            <field name="total_waste_kg"/>
                        </group>
                        <group string="Koordinat Lokasi Penjemputan">
                            <field name="nasabah_latitude"/>
                            <field name="nasabah_longitude"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action Nasabah -->
    <record id="action_sampah_nasabah" model="ir.actions.act_window">
        <field name="name">Data Nasabah</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_nasabah_sampah', '=', True)]</field>
        <field name="context">{'default_is_nasabah_sampah': True}</field>
    </record>

    <!-- Action Petugas Lapangan -->
    <record id="action_sampah_petugas" model="ir.actions.act_window">
        <field name="name">Data Petugas Lapangan</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_petugas_sampah', '=', True)]</field>
        <field name="context">{'default_is_petugas_sampah': True}</field>
    </record>
</odoo>
