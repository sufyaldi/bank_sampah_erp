<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sampah_pickup_task_tree" model="ir.ui.view">
        <field name="name">sirita.sampah.pickup.task.tree</field>
        <field name="model">sirita.sampah.pickup.task</field>
        <field name="arch" type="xml">
            <list string="Tugas Penjemputan Sampah">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="time_slot"/>
                <field name="nasabah_id"/>
                <field name="collector_id"/>
                <field name="pickup_address"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-warning="state in ('assigned', 'on_the_way')" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_sampah_pickup_task_form" model="ir.ui.view">
        <field name="name">sirita.sampah.pickup.task.form</field>
        <field name="model">sirita.sampah.pickup.task</field>
        <field name="arch" type="xml">
            <form string="Tugas Penjemputan">
                <header>
                    <button name="action_assign" string="Tugaskan Petugas" type="object" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_start" string="Mulai Jemput" type="object" class="btn-info" invisible="state != 'assigned'"/>
                    <button name="action_complete" string="Selesai Jemput" type="object" class="btn-success" invisible="state != 'on_the_way'"/>
                    <button name="action_cancel" string="Batalkan" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,assigned,on_the_way,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="No. Penugasan"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Jadwal &amp; Nasabah">
                            <field name="transaction_id"/>
                            <field name="nasabah_id"/>
                            <field name="scheduled_date"/>
                            <field name="time_slot"/>
                        </group>
                        <group string="Kurir / Petugas &amp; Lokasi">
                            <field name="collector_id"/>
                            <field name="pickup_address"/>
                            <field name="pickup_lat"/>
                            <field name="pickup_lng"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instruksi &amp; Catatan Khusus">
                            <field name="notes" placeholder="Patokan rumah, nomor telepon alternatif, barang berat, dll..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sampah_pickup_task" model="ir.actions.act_window">
        <field name="name">Penugasan Penjemputan</field>
        <field name="res_model">sirita.sampah.pickup.task</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
