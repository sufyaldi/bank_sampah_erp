<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sampah_reset_password_wizard_form" model="ir.ui.view">
        <field name="name">sampah.reset.password.wizard.form</field>
        <field name="model">sampah.reset.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Kata Sandi Nasabah">
                <group>
                    <field name="partner_id"/>
                    <field name="email"/>
                    <field name="new_password" password="True" placeholder="Masukkan password baru (min 6 karakter)"/>
                </group>
                <footer>
                    <button name="action_confirm_reset" string="Terapkan Password Baru" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Server / Window Action for opening wizard -->
    <record id="action_sampah_reset_password_wizard" model="ir.actions.act_window">
        <field name="name">Reset Password Akun</field>
        <field name="res_model">sampah.reset.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
